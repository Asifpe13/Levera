# Local development — no cloud deploy needed
MONGODB_URI=mongodb://localhost:27017/aigent_realestate

# Push notifications (optional — in-app notifications work without these)
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# EXPO_ACCESS_TOKEN=

# Expo mobile — override API URL on physical device
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Web frontend uses Vite proxy in dev; only needed for production build:
# VITE_API_URL=http://127.0.0.1:8000
